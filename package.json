{
  "name": "opencode-tmux-status",
  "version": "0.1.0",
  "description": "Report opencode session status to tmux (working / waiting / done / error / idle) plus desktop notifications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4m1z/opencode-tmux-status"
  },
  "homepage": "https://github.com/4m1z/opencode-tmux-status#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tmux",
    "status"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check src tests README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "bun-types": "^1.4.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  }
}
